<!DOCTYPE html>
<html>
<head>
    <title>Theft Report</title>
</head>
<body>
<h2>Theft Complaint Form</h2>
<form action="TheftResult.jsp" method="post">
    Name: <input type="text" name="name" /><br/>
    Mobile: <input type="text" name="mobile" /><br/>
    Age: <input type="number" name="age" /><br/>
    Address: <input type="text" name="address" /><br/>
    Location of Theft: <input type="text" name="location" /><br/>
    Item Lost: <input type="text" name="item" /><br/>
    Date of Loss: <input type="date" name="lostOn" /><br/>
    <input type="submit" value="Submit" />
</form>
</body>
</html>
